{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "server.ts",
    "app.tsx",
    "tasks.ts",
    "tasks.test.ts",
    "components",
    "lib",
    "text.ts",
    "hover.ts",
    "hover.test.ts",
    "themes.tsx"
  ]
}
