{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git push *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(brew *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(which *)",
      "Bash(man *)",
      "WebSearch"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Read(.env*)",
      "Read(secrets/**)"
    ],
    "ask": [
      "Bash(git push --force-with-lease *)",
      "Bash(git clean -f*)",
      "Bash(git restore .)",
      "Bash(git branch -D *)",
      "Bash(docker run *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(dd *)",
      "Bash(diskutil *)",
      "Bash(shutdown *)",
      "Bash(reboot *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sessions post-bash"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sessions register"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"/Users/ravern/.claude/plugins/cache/ponytail/ponytail/4.8.4/hooks/ponytail-statusline.sh\""
  },
  "enabledPlugins": {
    "braintrust@braintrust-claude-plugin": true,
    "greptile@claude-plugin": true,
    "ponytail@ponytail": true,
    "slack@claude-plugins-official": true,
    "vercel-plugin@vercel-vercel-plugin": true,
    "notion@claude-plugins-official": true,
    "github@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "braintrust-claude-plugin": {
      "source": {
        "source": "github",
        "repo": "braintrustdata/braintrust-claude-plugin"
      }
    },
    "claude-plugin": {
      "source": {
        "source": "github",
        "repo": "greptileai/claude-plugin"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true
}
